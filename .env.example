# Lấy ở Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# (Không bắt buộc) Máy chủ TURN cho mic/cam khi mạng chặn kết nối thẳng (4G, wifi công ty...).
# Lấy miễn phí ở metered.ca (Open Relay) hoặc Cloudflare Calls → TURN. Nhiều URL thì cách nhau dấu phẩy.
# VITE_TURN_URL=turn:global.relay.metered.ca:80,turns:global.relay.metered.ca:443?transport=tcp
# VITE_TURN_USERNAME=...
# VITE_TURN_CREDENTIAL=...
